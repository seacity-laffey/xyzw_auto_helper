{
  "name": "xyzw-token-manager",
  "version": "2.0.3",
  "type": "module",
  "description": "XYZW游戏Token管理器 - 支持Base64导入和WebSocket连接管理",
  "main": "desktop/main.cjs",
  "scripts": {
    "testr": "node ./test/roleToken.js",
    "testd": "node ./test/token.js",
    "dev": "vite",
    "build": "vite build",
    "deploy:cloudflare": "pnpm run build && pnpm dlx wrangler@4.120.1 pages deploy",
    "preview": "vite preview",
    "preview:cloudflare": "pnpm run build && pnpm dlx wrangler@4.120.1 pages dev dist",
    "lint": "eslint src --ext .vue,.js,.ts",
    "lint:baseline": "eslint src --ext .vue,.js,.ts --quiet --suppress-all --pass-on-unpruned-suppressions && eslint src --ext .vue,.js,.ts --quiet --prune-suppressions",
    "lint:fix": "eslint src --ext .vue,.js,.ts --fix",
    "format": "prettier --write \"src/**/*.{js,vue,ts,css,scss}\"",
    "test": "node --test test/*.test.js",
    "desktop:build": "vite build --mode desktop",
    "desktop:dev": "pnpm desktop:build && electron .",
    "desktop:package": "pnpm desktop:build && electron-forge package",
    "desktop:package:win": "pnpm desktop:build && electron-forge package --platform=win32 --arch=x64",
    "desktop:make:win": "pnpm desktop:build && electron-forge make --platform=win32 --arch=x64",
    "desktop:smoke": "pnpm desktop:build && electron test/desktop-smoke.cjs"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@lucide/vue": "^1.40.0",
    "@vicons/ionicons5": "^0.12.0",
    "@vicons/material": "^0.12.0",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "event-emitter3": "^1.0.4",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "lz4js": "^0.2.0",
    "moment": "^2.30.1",
    "naive-ui": "^2.43.1",
    "p-queue": "^7.4.1",
    "pinia": "^2.3.1",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@iconify-json/mdi": "^1.2.3",
    "@intlify/unplugin-vue-i18n": "^6.0.8",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.19.21",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.5.3",
    "electron": "44.2.0",
    "eslint": "9.39.3",
    "jiti": "^2.6.1",
    "postcss": "^8.5.19",
    "sass": "^1.93.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "unocss": "^0.61.9",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.4.1",
    "vite": "^5.4.11"
  },
  "keywords": [
    "vue",
    "token-management",
    "websocket",
    "base64",
    "game-automation",
    "xyzw",
    "frontend"
  ],
  "author": "XYZW Team",
  "license": "CC-BY-NC-SA-4.0",
  "packageManager": "pnpm@10.19.0",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@parcel/watcher",
      "vue-demi"
    ]
  }
}
